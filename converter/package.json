{
  "name": "deck-lovers-converter-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Jest tests for slides.pure.js",
  "scripts": {
    "test": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/js/**/*.test.js"],
    "collectCoverageFrom": ["<rootDir>/src/*.pure.js"],
    "coverageDirectory": "../test-results/converter-js",
    "coverageReporters": ["text", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  }
}

{
  "name": "deck-lovers-converter-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Jest tests for slides.pure.js",
  "scripts": {
    "test": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "overrides": {
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1",
    "deepmerge": "https://github.com/cristianfloresRC/deepmerge.git#fix/drop-proto-key-regardless-of-target"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/js/**/*.test.js"],
    "collectCoverageFrom": ["<rootDir>/src/*.pure.js"],
    "coverageDirectory": "../test-results/converter-js",
    "coverageReporters": ["text", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  }
}
